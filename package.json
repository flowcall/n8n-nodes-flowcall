{
	"name": "n8n-nodes-flowcall",
	"version": "0.1.0",
	"description": "n8n community node for Flowcall, the omnichannel AI customer service platform: create and list support tickets, and start workflows when tickets are created or resolved.",
	"license": "MIT",
	"homepage": "https://www.flowcall.co/",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"flowcall",
		"customer service",
		"helpdesk",
		"tickets"
	],
	"author": {
		"name": "Flowcall",
		"email": "marketing@flowcall.co",
		"url": "https://www.flowcall.co/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/flowcall/n8n-nodes-flowcall.git"
	},
	"bugs": {
		"url": "https://github.com/flowcall/n8n-nodes-flowcall/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/FlowcallApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Flowcall/Flowcall.node.js",
			"dist/nodes/FlowcallTrigger/FlowcallTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.56.3",
		"eslint": "9.29.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
